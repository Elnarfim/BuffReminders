{
	"runtime": {
		"version": "Lua 5.1",
		"builtin": {
			"basic": "disable",
			"debug": "disable",
			"io": "disable",
			"math": "disable",
			"os": "disable",
			"package": "disable",
			"string": "disable",
			"table": "disable",
			"utf8": "disable"
		}
	},
	"diagnostics": {
		"disable": ["undefined-global"]
	},
	"workspace": {
		"checkThirdParty": false,
		"ignoreDir": ["Libs", ".ignored"],
		"library": [".ignored/wow-api/Annotations/Core"]
	}
}
